# モデルファイル (大容量バイナリ)。ルート直下のみ無視 (src/models/ のソースは追跡する)。
# ISNet-anime OV IR (models/isnet-anime/model_ov_fp32.* 176MB / fp16 88MB) もここで無視。
# scripts/dollma_convert_matting.py で再生成する (ONNX は HF キャッシュ・_matting_paths.json)。
# ScorerNet OV IR (models/scorer-net/model_ov_fp32.* 45MB / fp16 22MB) も /models/ で無視。
# scripts/dollma_convert_scorer.py で再生成する (重み data/scorer/scorer_net_fp32.safetensors)。
/models/

# VAE ゴールデンデータ (計 ~400MB, GitHub 100MB 制限超)。
# scripts/dollma_dump_vae_golden.py で再生成する。不在時 test_vae_decode は [SKIP]。
src/tests/data/vae_weights.safetensors
src/tests/data/vae_io.safetensors
src/tests/data/vae_golden.png

# UNet ゴールデンデータ (計 ~2.6GB, GitHub 100MB 制限超)。
# scripts/dollma_dump_unet_golden.py で再生成する。不在時 test_unet は [SKIP]。
src/tests/data/unet_weights.safetensors
src/tests/data/unet_io.safetensors

# txt2img (2-6b) 実テキスト golden。scripts/dollma_dump_txt2img_golden.py で再生成。
# 不在時 test_text_conditioner / CFG E2E は [SKIP]。
src/tests/data/txt2img_io.safetensors
src/tests/data/txt2img_golden.png

# マッティング probe の中間 .npy マスク (32MB・golden と冗長・再生成可)。
# scripts/dollma_probe_matting.py で再生成。golden_isnet.safetensors / 比較 PNG は追跡。
src/tests/data/matting/*.npy

# Meson subprojects: wrap 定義のみ追跡し DL ソース/キャッシュは無視
# (meson が wrap から再取得する。ヘッダオンリーなので再現容易)
subprojects/*
!subprojects/*.wrap
!subprojects/packagefiles/

# 実行ログ・出力画像
logs/
outputs/

# BitNet データセットのキャッシュ (danbooru API 生取得・WD14 タグ csv)。
# scripts/dollma_make_pairs.py / dollma_build_vocab.py で再取得する。
# 成果物 (vocab.json / pairs.*.jsonl / stats.json) は追跡する。
data/bitnet/cache/
# 訓練済み重み (scripts/train_bitnet.py 再生成可・大容量)。
# vae/unet 重みと同様に追跡しない。train_stats.json (小) は追跡する。
data/bitnet/*.safetensors
# #6 突合 golden (logits/gen safetensors + manifest)。scripts/train_bitnet.py --dump-golden で再生成可。
data/bitnet/golden/
# smoke ラン成果物 (本番と別名・追跡しない)。
data/bitnet/train_stats_smoke.json
data/bitnet/train_stats_identity_smoke.json
# D6 (案c) の α/温度 sweep 変種・smoke (代表 train_stats_d6.json のみ追跡)。
data/bitnet/train_stats_d6_*.json
# seed 頑健性 sweep の scratch dir (本番 pairs/vocab のコピー + 結果・再生成可)。
# _seedsweep_b 等の施策別変種も含め一括無視 (大容量重みコピーを含むため)。
data/bitnet/_seedsweep*/
# 施策 C (評価作り直し) の中間ファイル (再生成可・凍結アンカーは pairs.eval_diverse_a/b.jsonl のみ追跡)。
data/bitnet/eval_diverse_prompts*.jsonl
data/bitnet/eval_diverse_texts*.jsonl
# 施策 A (実ペア増) の件数拡大変種 (再生成可・別名出力・大容量)。
# 凍結除外集合 eval_frozen_post_ids.json (恒久アンカー) は追跡する。
data/bitnet/pairs.identity.*.a12k.jsonl
data/bitnet/pairs.identity.*.a25k.jsonl
data/bitnet/stats.identity.a12k.json
data/bitnet/stats.identity.a25k.json
# 生成ログ (npz 生成等)。
scripts/archives/*.log

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# C++ ビルド成果物 (Meson)
build/
builddir/
*.obj
*.exe
*.dll
*.so
*.a

# IDE
.vscode/
.idea/
*.user

# Windows
Thumbs.db
desktop.ini

# .NET / Blazor UI (ui/) のビルド成果物
ui/bin/
ui/obj/
ui.Tests/bin/
ui.Tests/obj/
# UI のユーザーデータ (名前付きプリセット)。個人データなので追跡しない。
ui/data/

# Model B / B-3a 品質スコアラ教師データ (研究機実走で生成・再生成可)。
# 配管スキーマ例 (*.example.*) は追跡する。実 WD14 スコアベクタ・分割・重みは無視。
data/scorer/scorer_wd14.jsonl
data/scorer/scorer.train.jsonl
data/scorer/scorer.val.jsonl
data/scorer/scorer_stats.json
# B-3b ScorerNet 訓練 stats (per-epoch history・再生成可)。train_scorer.py が出力。
data/scorer/scorer_train_stats.json
data/scorer/*.safetensors
data/scorer/img/
data/scorer/weights/
# Q-1 quality 実採点の生成物 (dollma_score_quality_v4.py・再生成可)。
data/scorer/scorer_quality_report.json
data/scorer/*.qnull.bak.jsonl
# F-0a rollout 収集の生成物 (dollma_collect_rollouts.py・研究機実走で再生成可・PNG 群で大容量)。
# reward 分布/判定は docs (measurements-log/CLAUDE.md/roadmap) に記録済。
data/rollouts/

# Q-2 quality 枝: スクリプトが作る退避コピー (transient・元 jsonl は既に ignore)
data/scorer/*.bak.jsonl
