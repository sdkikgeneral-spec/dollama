# モデルファイル (大容量バイナリ)。ルート直下のみ無視 (src/models/ のソースは追跡する)。
/models/

# VAE ゴールデンデータ (計 ~400MB, GitHub 100MB 制限超)。
# scripts/dollma_dump_vae_golden.py で再生成する。不在時 test_vae_decode は [SKIP]。
src/tests/data/vae_weights.safetensors
src/tests/data/vae_io.safetensors
src/tests/data/vae_golden.png

# UNet ゴールデンデータ (計 ~2.6GB, GitHub 100MB 制限超)。
# scripts/dollma_dump_unet_golden.py で再生成する。不在時 test_unet は [SKIP]。
src/tests/data/unet_weights.safetensors
src/tests/data/unet_io.safetensors

# Meson subprojects: wrap 定義のみ追跡し DL ソース/キャッシュは無視
# (meson が wrap から再取得する。ヘッダオンリーなので再現容易)
subprojects/*
!subprojects/*.wrap
!subprojects/packagefiles/

# 実行ログ・出力画像
logs/
outputs/

# BitNet データセットのキャッシュ (danbooru API 生取得・WD14 タグ csv)。
# scripts/dollma_make_pairs.py / dollma_build_vocab.py で再取得する。
# 成果物 (vocab.json / pairs.*.jsonl / stats.json) は追跡する。
data/bitnet/cache/
# 訓練済み重み (scripts/train_bitnet.py 再生成可・大容量)。
# vae/unet 重みと同様に追跡しない。train_stats.json (小) は追跡する。
data/bitnet/*.safetensors
# #6 突合 golden (logits/gen safetensors + manifest)。scripts/train_bitnet.py --dump-golden で再生成可。
data/bitnet/golden/
# smoke ラン成果物 (本番と別名・追跡しない)。
data/bitnet/train_stats_smoke.json
data/bitnet/train_stats_identity_smoke.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# C++ ビルド成果物 (Meson)
build/
builddir/
*.obj
*.exe
*.dll
*.so
*.a

# IDE
.vscode/
.idea/
*.user

# Windows
Thumbs.db
desktop.ini

# .NET / Blazor UI (ui/) のビルド成果物
ui/bin/
ui/obj/
# UI のユーザーデータ (名前付きプリセット)。個人データなので追跡しない。
ui/data/
