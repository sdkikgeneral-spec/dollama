@page "/"
@rendermode InteractiveServer
@using Dollama.Ui.Services
@using Dollama.Ui.Telemetry
@inject DollamaClient Client
@inject NavigationManager Nav
@inject GenerationActivity Activity
@implements IAsyncDisposable

<PageTitle>dollama</PageTitle>

<div class="app">
    <header class="topbar">
        <div class="brand">dollama <span class="brand-sub">/ 全 HW 協調 2D キャラ生成</span></div>

        <!-- HW テレメトリ・ミニメーター (上部バーに横並び) -->
        <div class="telemetry-mini" title="@(_sample?.Generating == true ? "生成中 — RTX5080 が拡散を回しています" : "アイドル")">
            @if (_sample is null)
            {
                <span class="tm-hint">テレメトリ接続待ち…</span>
            }
            else
            {
                @foreach (var d in _sample.Devices)
                {
                    <div class="tm-item" title="@d.Device @d.Role @d.Percent.ToString("0")%">
                        <span class="tm-dev">@d.Device</span>
                        <span class="tm-bar"><span class="tm-fill" style="width:@d.Percent.ToString("0")%"></span></span>
                        <span class="tm-pct">@d.Percent.ToString("0")%</span>
                    </div>
                }
            }
        </div>

        <!-- タグ表示言語トグル ([日本語|EN])。タグ値・生成 prompt は英語のまま不変で表示のみ切替。 -->
        <div class="lang-toggle" title="タグの表示言語 (内部値・生成は英語のまま)">
            <button type="button" class="@(_tagLang == "ja" ? "on" : "")"
                    @onclick="@(() => SetTagLang("ja"))">日本語</button>
            <button type="button" class="@(_tagLang == "en" ? "on" : "")"
                    @onclick="@(() => SetTagLang("en"))">EN</button>
        </div>

        <div class="conn @(_connected ? "ok" : "ng")">
            <span class="dot"></span>@(_connected ? "C++ サーバー接続中" : "未接続")
        </div>
    </header>

    <CascadingValue Value="_tagLang" Name="TagLang">
    <div class="main">
        <!-- 左ペイン: タグパレット + プリセット一覧 -->
        <aside class="sidebar">
            <TagPalette @bind-Target="_target" OnAddTag="AddTag" />
            <PresetSidebar @ref="_presetSidebar" OnLoad="LoadPreset" />
        </aside>

        <!-- 中央: 生成コントロール -->
        <section class="gen">
            <TagPresetField Label="プロンプト" Kind="prompt"
                            @bind-Tags="_promptTags"
                            CurrentImage="_imageBytes"
                            OnSaved="RefreshPresets"
                            OnFocused="SetTarget"
                            Placeholder="例: 1girl と入力して Enter" />

            <TagPresetField Label="ネガティブ" Kind="negative"
                            @bind-Tags="_negativeTags"
                            CurrentImage="_imageBytes"
                            OnSaved="RefreshPresets"
                            OnFocused="SetTarget"
                            Placeholder="例: lowres, bad anatomy" />

            <div class="row">
                <label class="field">
                    <span>サイズ</span>
                    <select @bind="_size">
                        <option value="512x512">512 x 512</option>
                        <option value="768x768">768 x 768</option>
                        <option value="1024x1024">1024 x 1024</option>
                    </select>
                </label>
                <label class="field grow">
                    <span>ステップ: @_steps</span>
                    <input type="range" min="1" max="50" @bind="_steps" @bind:event="oninput" />
                </label>
            </div>

            <!-- 本番生成 / 下書き高速プレビューの 2 ボタン横並び -->
            <div class="gen-actions">
                <button class="generate" @onclick="@(() => GenerateAsync(false))" disabled="@_busy">
                    @((_busy && !_runningDraft) ? "生成中…" : "生成")
                </button>
                <button class="generate secondary" @onclick="@(() => GenerateAsync(true))" disabled="@_busy">
                    @((_busy && _runningDraft) ? "生成中…" : "下書き(高速プレビュー)")
                </button>
            </div>

            @if (_error is not null)
            {
                <div class="error">@_error</div>
            }
        </section>

        <!-- 右ペイン: 生成画像プレビュー専任 -->
        <section class="canvas">
            @* 直近プレビューのモード・実送信サイズをバッジ表示。生成前/未生成時は非表示。 *@
            @if (_lastMode is not null)
            {
                <div class="gen-mode">@_lastMode</div>
            }
            <div class="preview">
                @if (_busy)
                {
                    <div class="spinner"></div>
                }
                else if (_imageData is not null)
                {
                    <img src="data:image/png;base64,@_imageData" alt="generated" />
                }
                else
                {
                    <div class="placeholder">生成画像がここに表示されます</div>
                }
            </div>
        </section>
    </div>
    </CascadingValue>
</div>

@code {
    private List<string> _promptTags = new();
    private List<string> _negativeTags = new();
    private string _size = "1024x1024";
    private int _steps = 20;

    // パレットのタグ追加先 ("prompt" / "negative" / "favorites") の真実源。
    // 中央入力欄・お気に入り入力欄のフォーカスで自動更新し (SetTarget / パレット側 onfocus)、
    // TagPalette とは @bind-Target で双方向共有する。
    // 初期状態 (どこも未フォーカス) は従来どおりプロンプト。
    // favorites の登録は TagPalette 内で完結するため、ここへ TagAdd が飛んでくるのは
    // prompt/negative のときだけ。
    private string _target = "prompt";

    // タグの表示言語。既定は日本語。配下のパレット・チップへ CascadingValue で伝播する。
    // タグ値・C++ へ送る prompt は英語のまま不変で、これは表示専用の真実源。
    private string _tagLang = "ja";

    private bool _busy;
    private bool _runningDraft;    // 現在 busy 中の生成が下書きモードかどうか (文言出し分け用)
    private string? _error;
    private string? _imageData;   // base64 PNG (img 表示用)
    private byte[]? _imageBytes;  // 生成画像の生バイト (プリセット保存サムネ用)
    private bool _connected;

    // 直近プレビューのモードバッジ文言 (例「下書き 768²」「本番 1024²」)。未生成時は null で非表示。
    private string? _lastMode;

    private HubConnection? _hub;
    private TelemetrySample? _sample;

    // 左ペインのプリセット一覧。保存/削除後に Refresh して最新化する。
    private PresetSidebar? _presetSidebar;

    // 中央入力欄のフォーカスを受けて追加先を更新する (フォーカス連動)。
    // プロンプト欄にフォーカス → 追加先=プロンプト、ネガティブ欄にフォーカス → 追加先=ネガティブ。
    // お気に入り入力欄のフォーカスは TagPalette 側で追加先=favorites に切り替える。
    // @bind-Target でパレットのトグルハイライトも追従する。
    private void SetTarget(string kind)
    {
        _target = kind;
    }

    // 表示言語を切り替える。CascadingValue 経由で配下 (パレット・チップ) が再描画される。
    private void SetTagLang(string lang)
    {
        _tagLang = lang;
        StateHasChanged();
    }

    // 接続チェックと SignalR 購読は「インタラクティブ確立後 (= 最初の描画後)」に行う。
    // OnInitializedAsync でやるとプリレンダリング中に HealthAsync(最大2秒) と
    // 自己 SignalR 接続が走り、最初のバイトが返るまで固まってブラウザが
    // 「ページを読み込めませんでした」になる。OnAfterRenderAsync なら描画は即返る。
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // 接続インジケータ (初回チェック)
        _connected = await Client.HealthAsync();
        await InvokeAsync(StateHasChanged);

        // テレメトリ Hub を購読
        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/telemetry"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<TelemetrySample>("Update", sample =>
        {
            _sample = sample;
            // Hub コールバックは別コンテキストなので InvokeAsync で UI スレッドへ
            return InvokeAsync(StateHasChanged);
        });

        await _hub.StartAsync();
    }

    // パレットからのタグ追加 (追加先が prompt/negative のときのみ到達)。
    // target で行き先の列を選び、新リスト再代入で TagInput (子) に確実に反映させる
    // (リストの参照を変えないと再描画が走らない)。
    // 安全側に倒し、negative は negative・prompt は prompt のみ処理し、それ以外
    // (favorites 等の未知 target) は無視する (favorites は TagPalette 内で完結し
    // ここへは来ない想定だが、万一来ても prompt へ誤混入させない)。
    private void AddTag(TagAdd add)
    {
        var tag = (add.Tag ?? "").Trim().ToLowerInvariant();
        if (tag.Length == 0)
        {
            return;
        }

        if (string.Equals(add.Target, "negative", StringComparison.OrdinalIgnoreCase))
        {
            if (!_negativeTags.Contains(tag))
            {
                _negativeTags = new List<string>(_negativeTags) { tag };
            }
        }
        else if (string.Equals(add.Target, "prompt", StringComparison.OrdinalIgnoreCase))
        {
            if (!_promptTags.Contains(tag))
            {
                _promptTags = new List<string>(_promptTags) { tag };
            }
        }
        // それ以外 (未知 target) は無視 — 誤混入を防ぐ。
    }

    // 左ペインのプリセットカードをクリックでロード。kind に応じて該当列を置換する。
    // 新リストを作って差し込み TagInput に反映させる。
    private void LoadPreset(TagPreset p)
    {
        if (string.Equals(p.Kind, "negative", StringComparison.OrdinalIgnoreCase))
        {
            _negativeTags = new List<string>(p.Tags);
        }
        else
        {
            _promptTags = new List<string>(p.Tags);
        }
    }

    // 保存後に左ペインのプリセット一覧を最新化する。
    private void RefreshPresets()
    {
        _presetSidebar?.Refresh();
    }

    // 生成。draft=true のときだけ解像度を下書き (768²) へ落として高速プレビューする。
    // 本番 (draft=false) は従来どおり選択サイズ (_size) で生成する。
    // ステップ数は両モード共通で据え置き (本番と同じ重み・同じ step・解像度だけ違う)。
    // _size 自体は書き換えず req.Size をローカルに上書きするだけ (下書き後に本番を押せば選択サイズで出る)。
    private async Task GenerateAsync(bool draft = false)
    {
        if (_busy || _promptTags.Count == 0)
        {
            return;
        }

        _busy = true;
        _runningDraft = draft;
        _error = null;
        _imageData = null;
        _imageBytes = null;
        StateHasChanged();

        // 実際に C++ サーバーへ送る size。下書きのときだけ落とす。
        var sendSize = draft ? DraftPreview.ResolveDraftSize(_size) : _size;

        var req = new GenerationRequest
        {
            Prompt = string.Join(", ", _promptTags),
            NegativePrompt = _negativeTags.Count == 0 ? null : string.Join(", ", _negativeTags),
            Size = sendSize,
            Steps = _steps,
        };

        // 生成中フラグを立てる → TelemetryBroadcaster が GPU を高負荷側に振る
        Activity.Enter();
        try
        {
            var png = await Client.GenerateAsync(req);
            _imageBytes = png; // 生バイトを保持 (プリセット保存時のサムネ元)
            _imageData = Convert.ToBase64String(png);
            _connected = true;
            // 成功後にモードバッジを記録 (例「下書き 768²」「本番 1024²」)。
            _lastMode = $"{(draft ? "下書き" : "本番")} {ModeBadge(sendSize)}";
        }
        catch (GenerationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"接続エラー: {ex.Message}";
            _connected = false;
        }
        finally
        {
            Activity.Exit();
            _busy = false;
        }
    }

    // "WxH" の幅を取り出して「768²」形式に整形する。パース不能ならそのまま返す。
    private static string ModeBadge(string size)
    {
        var parts = size.Split('x', 'X');
        if (parts.Length >= 1 && int.TryParse(parts[0].Trim(), out var w))
        {
            return $"{w}²";
        }
        return size;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
