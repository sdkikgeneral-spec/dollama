@page "/"
@rendermode InteractiveServer
@using Dollama.Ui.Services
@using Dollama.Ui.Telemetry
@inject DollamaClient Client
@inject NavigationManager Nav
@inject GenerationActivity Activity
@implements IAsyncDisposable

<PageTitle>dollama</PageTitle>

<div class="app">
    <header class="topbar">
        <div class="brand">dollama <span class="brand-sub">/ 全 HW 協調 2D キャラ生成</span></div>

        @* 生成中バッジ (P2-10 / 課題 #11)。テレメトリのグローと対で「今 HW が動いている」を
           面で示す。従来は Generating が title 属性 (ホバー) にしか出ていなかった。 *@
        @if (_sample?.Generating == true)
        {
            <span class="gen-pill">生成中</span>
        }

        <!-- HW テレメトリ・ミニメーター (上部バーに横並び)。
             生成中は generating クラスでバーを各デバイス色に光らせる (P2-10)。 -->
        <div class="telemetry-mini @(_sample?.Generating == true ? "generating" : null)"
             title="@(_sample?.Generating == true ? "生成中 — RTX5080 が拡散を回しています" : "アイドル")">
            @if (_sample is null)
            {
                <span class="tm-hint">テレメトリ接続待ち…</span>
            }
            else
            {
                @foreach (var d in _sample.Devices)
                {
                    <div class="tm-item @DeviceStyle.CssClass(d.Device)" title="@d.Device @d.Role @d.Percent.ToString("0")%">
                        <span class="tm-dev">@d.Device</span>
                        <span class="tm-bar"><span class="tm-fill" style="width:@d.Percent.ToString("0")%"></span></span>
                        <span class="tm-pct">@d.Percent.ToString("0")%</span>
                        @* 役割ラベル (P3-3 / §4.4-3)。「NPU が CLIP を、RTX5080 が UNet を」という
                           パイプライン理解を title 属性 (ホバー) 頼みにしない。
                           出す/出さないは CSS だけで決まる (既定 display:none・幅に余裕がある時だけ表示) —
                           razor に状態は増やさない (テレメトリの真実源は _sample のまま)。
                           バーの開始位置が役割名の長さでずれないよう、必ず行の末尾に置く。 *@
                        <span class="tm-role">@d.Role</span>
                    </div>
                }
            }
        </div>

        <!-- タグ表示言語トグル ([日本語|EN])。タグ値・生成 prompt は英語のまま不変で表示のみ切替。 -->
        <div class="lang-toggle" title="タグの表示言語 (内部値・生成は英語のまま)">
            <button type="button" class="btn btn-ghost @(_tagLang == "ja" ? "on" : "")"
                    @onclick="@(() => SetTagLang("ja"))">日本語</button>
            <button type="button" class="btn btn-ghost @(_tagLang == "en" ? "on" : "")"
                    @onclick="@(() => SetTagLang("en"))">EN</button>
        </div>

        @* 接続インジケータ。未接続のときだけ「再接続」ボタンを添える (P2-9)。
           定期ポーリングはしない — 再判定は「初回描画」「生成の成否」「このボタン」の 3 経路のみ。 *@
        <div class="conn @(_connected ? "ok" : "ng")">
            <span class="dot"></span>@(_connected ? "C++ サーバー接続中" : "未接続")
            @if (!_connected)
            {
                <button type="button" class="btn btn-ghost" @onclick="ReconnectAsync"
                        disabled="@_reconnecting" title="GET /health を 1 回だけ再試行します">
                    @(_reconnecting ? "確認中…" : "再接続")
                </button>
            }
        </div>
    </header>

    <CascadingValue Value="_tagLang" Name="TagLang">
    <div class="main">
        <!-- 左ペイン: タグパレット + プリセット一覧 -->
        <aside class="sidebar">
            <TagPalette @bind-Target="_target" OnAddTag="AddTag" />
            <PresetSidebar @ref="_presetSidebar" OnLoad="LoadPreset" />
        </aside>

        <!-- 中央: 生成コントロール。
             Ctrl+Enter はチップ入力にフォーカスがあっても効くよう、section で keydown を拾う
             (子の入力欄から素直にバブリングしてくる)。 -->
        <section class="gen" @onkeydown="OnSectionKeyDown">
            @* IsTarget は「パレットのタグが今ここに入る」の可視化 (P2-6 / 課題 #9)。
               判定は親のここで行い、子は結果を受け取るだけ (真実源は _target のまま)。 *@
            <TagPresetField @ref="_promptField"
                            Label="プロンプト" Kind="prompt"
                            @bind-Tags="_promptTags"
                            CurrentImage="_imageBytes"
                            OnSaved="RefreshPresets"
                            OnFocused="SetTarget"
                            IsTarget="@(_target == "prompt")"
                            DraftEmptyChanged="OnPromptDraftEmptyChanged"
                            Placeholder="例: 1girl と入力して Enter" />

            <TagPresetField @ref="_negativeField"
                            Label="ネガティブ" Kind="negative"
                            @bind-Tags="_negativeTags"
                            CurrentImage="_imageBytes"
                            OnSaved="RefreshPresets"
                            OnFocused="SetTarget"
                            IsTarget="@(_target == "negative")"
                            Placeholder="例: lowres, bad anatomy" />

            <div class="row">
                <label class="field">
                    <span>サイズ</span>
                    <select @bind="_size">
                        <option value="512x512">512 x 512</option>
                        <option value="768x768">768 x 768</option>
                        <option value="1024x1024">1024 x 1024</option>
                    </select>
                </label>
                <label class="field grow">
                    <span>ステップ: @_steps</span>
                    <input type="range" min="1" max="50" @bind="_steps" @bind:event="oninput" />
                </label>
            </div>

            <!-- ランタイム LoRA 選択チップ (L-2)。未選択なら loras キーを送らない。 -->
            <LoraChips @bind-Selected="_loras" />

            @* 生成できるか / 押せないなら理由は何か は純クラス GenerateGate に集約する
               (razor に条件式を散らさない・Ctrl+Enter も同じ判定を通る)。
               未確定テキストがあれば確定タグ 0 でも押せる = 押したときに確定してから生成する。 *@
            @{
                var gate = GenerateGate.Evaluate(_busy, _connected, _promptTags.Count, _promptDraftEmpty);
            }

            <!-- 本番生成 / 下書き高速プレビューの 2 ボタン横並び -->
            <div class="gen-actions">
                <button class="btn btn-primary" @onclick="@(() => GenerateAsync(false))" disabled="@(!gate.CanGenerate)">
                    @((_busy && !_runningDraft) ? "生成中…" : "生成")
                </button>
                <button class="btn btn-ghost" @onclick="@(() => GenerateAsync(true))" disabled="@(!gate.CanGenerate)">
                    @((_busy && _runningDraft) ? "生成中…" : "下書き(高速プレビュー)")
                </button>
            </div>

            @* 押せない理由を明示する (無言失敗の根絶・課題 #2)。押せるときは何も出さない。 *@
            @if (gate.Reason is not null)
            {
                <div class="gen-reason">@gate.Reason</div>
            }

            @if (_error is not null)
            {
                <div class="error">@_error</div>
            }
        </section>

        <!-- 右ペイン: 生成画像プレビュー専任 -->
        <section class="canvas">
            @* 直近プレビューのモード・実送信サイズをバッジ表示。生成前/未生成時は非表示。 *@
            @if (_lastMode is not null)
            {
                <div class="gen-mode">@_lastMode</div>
            }

            @* 生成画像の保存導線 (P2-3 / 課題 #8)。data URI の a[download] なので JS interop は要らない。
               生成中は減光した前回画像の上にオーバーレイが載るので出さない。 *@
            @if (_imageData is not null && !_busy)
            {
                <a class="btn btn-ghost canvas-save" download="@_downloadName"
                   href="data:image/png;base64,@_imageData"
                   title="@_downloadName として保存します">PNG 保存</a>
            }
            @* 生成中も前回画像を破棄せず減光して残す (P2-2 / 課題 #6)。
               下書き → 本番の見比べができ、生成のたびにプレースホルダへフラッシュしない。
               スピナーと経過秒 (課題 #7) はその上へ絶対配置でかぶせる。 *@
            <div class="preview">
                @if (_imageData is not null)
                {
                    <img class="@(_busy ? "preview-dim" : null)"
                         src="data:image/png;base64,@_imageData" alt="generated" />
                }
                else if (!_busy)
                {
                    <div class="placeholder">生成画像がここに表示されます</div>
                }

                @if (_busy)
                {
                    <div class="preview-overlay">
                        <div class="spinner"></div>
                        <div class="preview-elapsed">@ElapsedFormat.Mmss(_elapsed)</div>
                    </div>
                }
            </div>

            @* 直近生成のミニ履歴 (P3-5)。**直近 4 枚を新しい順に並べる / クリックで再表示 /
               選択中が分かる / 空なら出ない** の 4 つだけ。並び替え規則は純クラス
               Services/PreviewHistory.cs が持ち、ここは器と結線だけを書く。

               ★ 置き場所はプレビュー枠 (.preview) の **外**・右ペイン (.canvas) の中。
                 枠の中に絶対配置で重ねる案は「生成物を隠す」ので不採用 (PL 裁定)。
               ★ セッション内メモリのみ。永続化 (ファイル / localStorage / presets.json) はしない —
                 「設定ごと復元」はプリセットの役割で、ここは「さっきの絵に戻る」だけ。
                 タブを閉じる / 回線が切れて circuit が作り直されると履歴も消える (仕様)。
               ★ 生成中はクリックさせない (disabled)。完了時に上書きされるだけの操作を
                 受け付けると、P2-2 の減光対象 (見比べている前回画像) が入れ替わってしまう。 *@
            @if (_history.Count > 0)
            {
                <div class="thumbs">
                    @foreach (var item in _history)
                    {
                        <button type="button" @key="item.Id"
                                class="thumb @(PreviewHistory.IsSelected(item, _selectedId) ? "on" : null)"
                                disabled="@_busy"
                                title="@item.Badge"
                                @onclick="@(() => SelectHistory(item.Id))">
                            <img src="data:image/png;base64,@item.Base64" alt="@item.Badge" />
                        </button>
                    }
                </div>
            }
        </section>
    </div>
    </CascadingValue>
</div>

@code {
    private List<string> _promptTags = new();
    private List<string> _negativeTags = new();
    private string _size = "1024x1024";
    private int _steps = 20;

    // 選択中の LoRA (LoraChips と @bind-Selected で双方向共有)。空なら生成時に null にして送らない。
    private List<LoraSpec> _loras = new();

    // パレットのタグ追加先 ("prompt" / "negative" / "favorites") の真実源。
    // 中央入力欄・お気に入り入力欄のフォーカスで自動更新し (SetTarget / パレット側 onfocus)、
    // TagPalette とは @bind-Target で双方向共有する。
    // 初期状態 (どこも未フォーカス) は従来どおりプロンプト。
    // favorites の登録は TagPalette 内で完結するため、ここへ TagAdd が飛んでくるのは
    // prompt/negative のときだけ。
    private string _target = "prompt";

    // タグの表示言語。既定は日本語。配下のパレット・チップへ CascadingValue で伝播する。
    // タグ値・C++ へ送る prompt は英語のまま不変で、これは表示専用の真実源。
    private string _tagLang = "ja";

    private bool _busy;
    private bool _runningDraft;    // 現在 busy 中の生成が下書きモードかどうか (文言出し分け用)
    private string? _error;
    private string? _imageData;   // base64 PNG (img 表示用)
    private byte[]? _imageBytes;  // 生成画像の生バイト (プリセット保存サムネ用)
    private bool _connected;

    // 「再接続」ボタンの二度押し防止 (P2-9)。押している間だけ true。
    private bool _reconnecting;

    // 直近プレビューのモードバッジ文言 (例「下書き 768²」「本番 1024²」)。未生成時は null で非表示。
    private string? _lastMode;

    // 「PNG 保存」の download 属性に出すファイル名 (P2-3)。表示中の画像が生成された
    // 時刻と実送信サイズで決まるので、成功時に 1 回だけ組み立てて保持する。
    private string? _downloadName;

    // ── 直近生成のミニ履歴 (P3-5) ──────────────────────────────
    // 新しい順・最大 PreviewHistory.Capacity (4) 枚。並び替え規則は純クラス側が持ち、
    // ここは「新しいリストを再代入する」だけ (その場 Mutate は再描画が走らない)。
    //
    // ★ 型は IReadOnlyList。List にすると _history.Add(...) と書けてしまい、
    //   本プロジェクト頻出の「中身は変わったのに画面が更新されない」バグの入口になる。
    // ★ 履歴が持つのは base64 文字列だけで byte[] は持たない (PL 裁定・実装メモ参照)。
    //   生バイトが要るのは選択された 1 枚だけなので、ShowResult で 1 回 decode する。
    // ★ circuit と一緒に消えるのが仕様。DisposeAsync での明示クリアは書かない。
    private IReadOnlyList<PreviewItem> _history = Array.Empty<PreviewItem>();

    // 今プレビューに出ている履歴 1 枚の Id。0 = 未選択 (起動直後 / 履歴が空)。
    private int _selectedId;

    // 履歴 Id の採番 (単調増加)。同じ Id が 2 枚並ばないので選択中は常に高々 1 枚。
    private int _nextId;

    // 生成開始からの経過時間 (生成中オーバーレイの表示用・P2-2)。表示整形は ElapsedFormat。
    private TimeSpan _elapsed;

    // 経過秒タイマーの停止用。生成の finally と DisposeAsync の両方から必ず落とす。
    private CancellationTokenSource? _tickCts;

    private HubConnection? _hub;
    private TelemetrySample? _sample;

    // 左ペインのプリセット一覧。保存/削除後に Refresh して最新化する。
    private PresetSidebar? _presetSidebar;

    // 中央 2 フィールドへの参照。生成直前に未確定テキストを確定させる (P2-1) ために持つ。
    private TagPresetField? _promptField;
    private TagPresetField? _negativeField;

    // プロンプト欄の未確定テキストが空か (子から真偽だけ通知される)。
    // 生成ボタンの活性判定にのみ使う。draft の文字列そのものは子が真実源で親は持たない。
    private bool _promptDraftEmpty = true;

    // プロンプト欄の未確定テキストの有無を受け取り、生成ボタンの活性を追従させる。
    private void OnPromptDraftEmptyChanged(bool empty)
    {
        _promptDraftEmpty = empty;
    }

    // 未接続時の「再接続」(P2-9)。GET /health を 1 回だけ叩き直す (定期ポーリングはしない)。
    // HealthAsync は内部で例外を握りつぶすので、ここは二度押し防止だけを見る。
    private async Task ReconnectAsync()
    {
        if (_reconnecting)
        {
            return;
        }
        _reconnecting = true;
        try
        {
            _connected = await Client.HealthAsync();
        }
        finally
        {
            _reconnecting = false;
        }
    }

    // Ctrl+Enter (Mac は Cmd+Enter) で生成する (P2-8)。
    // section で拾うのでチップ入力にフォーカスがあっても効く。
    // 可否判定は GenerateAsync 内の GenerateGate に一本化されている。
    private async Task OnSectionKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            await GenerateAsync(false);
        }
    }

    // 中央入力欄のフォーカスを受けて追加先を更新する (フォーカス連動)。
    // プロンプト欄にフォーカス → 追加先=プロンプト、ネガティブ欄にフォーカス → 追加先=ネガティブ。
    // お気に入り入力欄のフォーカスは TagPalette 側で追加先=favorites に切り替える。
    // @bind-Target でパレットのトグルハイライトも追従する。
    private void SetTarget(string kind)
    {
        _target = kind;
    }

    // 表示言語を切り替える。CascadingValue 経由で配下 (パレット・チップ) が再描画される。
    private void SetTagLang(string lang)
    {
        _tagLang = lang;
        StateHasChanged();
    }

    // 接続チェックと SignalR 購読は「インタラクティブ確立後 (= 最初の描画後)」に行う。
    // OnInitializedAsync でやるとプリレンダリング中に HealthAsync(最大2秒) と
    // 自己 SignalR 接続が走り、最初のバイトが返るまで固まってブラウザが
    // 「ページを読み込めませんでした」になる。OnAfterRenderAsync なら描画は即返る。
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // 接続インジケータ (初回チェック)
        _connected = await Client.HealthAsync();
        await InvokeAsync(StateHasChanged);

        // テレメトリ Hub を購読
        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/telemetry"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<TelemetrySample>("Update", sample =>
        {
            _sample = sample;
            // Hub コールバックは別コンテキストなので InvokeAsync で UI スレッドへ
            return InvokeAsync(StateHasChanged);
        });

        await _hub.StartAsync();
    }

    // パレットからのタグ追加 (追加先が prompt/negative のときのみ到達)。
    // target で行き先の列を選び、新リスト再代入で TagInput (子) に確実に反映させる
    // (リストの参照を変えないと再描画が走らない)。
    // 安全側に倒し、negative は negative・prompt は prompt のみ処理し、それ以外
    // (favorites 等の未知 target) は無視する (favorites は TagPalette 内で完結し
    // ここへは来ない想定だが、万一来ても prompt へ誤混入させない)。
    private void AddTag(TagAdd add)
    {
        // 正規化規則はチップ確定 (TagInput) と同じ TagCommit.Normalize に寄せる。
        var tag = TagCommit.Normalize(add.Tag);
        if (tag.Length == 0)
        {
            return;
        }

        if (string.Equals(add.Target, "negative", StringComparison.OrdinalIgnoreCase))
        {
            if (!_negativeTags.Contains(tag))
            {
                _negativeTags = new List<string>(_negativeTags) { tag };
            }
        }
        else if (string.Equals(add.Target, "prompt", StringComparison.OrdinalIgnoreCase))
        {
            if (!_promptTags.Contains(tag))
            {
                _promptTags = new List<string>(_promptTags) { tag };
            }
        }
        // それ以外 (未知 target) は無視 — 誤混入を防ぐ。
    }

    // 左ペインのプリセットカードをクリックでロード。kind に応じて該当列を置換する。
    // 新リストを作って差し込み TagInput に反映させる。
    private void LoadPreset(TagPreset p)
    {
        if (string.Equals(p.Kind, "negative", StringComparison.OrdinalIgnoreCase))
        {
            _negativeTags = new List<string>(p.Tags);
        }
        else
        {
            _promptTags = new List<string>(p.Tags);
        }
    }

    // 保存後に左ペインのプリセット一覧を最新化する。
    private void RefreshPresets()
    {
        _presetSidebar?.Refresh();
    }

    // 生成。draft=true のときだけ解像度を下書き (768²) へ落として高速プレビューする。
    // 本番 (draft=false) は従来どおり選択サイズ (_size) で生成する。
    // ステップ数は両モード共通で据え置き (本番と同じ重み・同じ step・解像度だけ違う)。
    // _size 自体は書き換えず req.Size をローカルに上書きするだけ (下書き後に本番を押せば選択サイズで出る)。
    private async Task GenerateAsync(bool draft = false)
    {
        if (_busy)
        {
            return;
        }

        // 未確定テキストを先に確定させる (P2-1)。blur は生成ボタンの click と別の
        // SignalR ラウンドトリップになり順序が保証されないので、ここで明示的に await する。
        if (_promptField is not null)
        {
            await _promptField.CommitPendingAsync();
        }
        if (_negativeField is not null)
        {
            await _negativeField.CommitPendingAsync();
        }

        // 確定後の状態で可否を判定する (ボタン disabled と同じ純ロジックを通す)。
        if (!GenerateGate.Evaluate(_busy, _connected, _promptTags.Count, _promptDraftEmpty).CanGenerate)
        {
            return;
        }

        _busy = true;
        _runningDraft = draft;
        _error = null;
        // ★ _imageData / _imageBytes はここで破棄しない (P2-2)。前回画像を減光して残し、
        //   成功したときだけ差し替える (失敗しても直前の絵が消えない)。
        StateHasChanged();

        // 経過秒タイマーを起動する (1 秒刻み)。fire-and-forget にはせず、
        // 下の finally で Cancel → await して必ず終わらせる。
        _elapsed = TimeSpan.Zero;
        var tickCts = new CancellationTokenSource();
        _tickCts = tickCts;
        var tickTask = TickElapsedAsync(DateTimeOffset.UtcNow, tickCts.Token);

        // 実際に C++ サーバーへ送る size。下書きのときだけ落とす。
        var sendSize = draft ? DraftPreview.ResolveDraftSize(_size) : _size;

        var req = new GenerationRequest
        {
            Prompt = string.Join(", ", _promptTags),
            NegativePrompt = _negativeTags.Count == 0 ? null : string.Join(", ", _negativeTags),
            Size = sendSize,
            Steps = _steps,
            // LoRA 未選択なら null にして "loras" キー自体を送らない (従来経路無改変・ガード1)。
            Loras = _loras.Count == 0 ? null : new List<LoraSpec>(_loras),
        };

        // 生成中フラグを立てる → TelemetryBroadcaster が GPU を高負荷側に振る
        Activity.Enter();
        try
        {
            var png = await Client.GenerateAsync(req);
            _connected = true;

            // 1 回の生成の成果を 1 つの値にまとめる (P3-5)。
            // ・バッジ文言の組み立ては純クラス PreviewLabel が唯一の合流点
            //   (例「下書き 768²」「本番 1024²」)
            // ・保存ファイル名もここで確定する = 表示中の画像と必ず対になる
            // ・持つのは base64 だけ。生バイトは ShowResult が 1 回だけ decode する
            var item = new PreviewItem(
                ++_nextId,
                Convert.ToBase64String(png),
                PreviewLabel.Build(draft, sendSize),
                DownloadName.ForPng(DateTime.Now, sendSize),
                DateTimeOffset.Now);

            // ★ 履歴へ積むのは成功したときだけ (この try の成功経路 1 箇所のみ)。
            //   catch / finally から積むと、失敗した生成がサムネ列に並ぶ。
            _history = PreviewHistory.Add(_history, item);
            ShowResult(item);
        }
        catch (GenerationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"接続エラー: {ex.Message}";
            _connected = false;
        }
        finally
        {
            Activity.Exit();
            _busy = false;

            // 成功・失敗のどちらでもタイマーを確実に止める (経路 1・2)。
            // 先に参照を外してから Cancel/Dispose するので、DisposeAsync から
            // 破棄済みの cts が見えることはない。
            _tickCts = null;
            tickCts.Cancel();
            await tickTask;
            tickCts.Dispose();
        }
    }

    // ★ 表示中の 1 枚を決める唯一の場所 (P3-5 の funnel)。
    //
    //   _imageData (絵) / _imageBytes (プリセット保存のサムネ元) / _lastMode (モードバッジ) /
    //   _downloadName (PNG 保存のファイル名) の 4 つは **同じ 1 回の生成を指す 1 組**で、
    //   バラバラに代入すると「古いサムネを押したら絵だけ戻ってバッジは本番のまま・
    //   PNG 保存のファイル名が別の生成のもの」という混線が起きる。**この 4 つへの代入は
    //   ここにしか書かない** (ui.Tests/PreviewHistoryRazorTests が構文レベルで縛る)。
    //
    //   base64 → 生バイトの decode もここ 1 箇所だけ。履歴は base64 しか持たないので、
    //   選択された 1 枚だけを decode すれば足りる (毎描画でも毎生成でもなく、選択時に 1 回)。
    private void ShowResult(PreviewItem item)
    {
        _imageData = item.Base64;
        _imageBytes = Convert.FromBase64String(item.Base64);
        _lastMode = item.Badge;
        _downloadName = item.DownloadName;
        _selectedId = item.Id;
    }

    // 履歴サムネのクリック (P3-5)。押せるのは生成していないときだけ —
    // 生成中に選び直しても完了時に上書きされるだけで、その間 P2-2 の減光対象
    // (今なにと見比べているのか) が入れ替わってしまう。markup 側でも disabled にしてある。
    // 見つからない Id (履歴から落ちた直後など) は「何も起きない」で正しい。
    private void SelectHistory(int id)
    {
        if (_busy)
        {
            return;
        }

        var item = PreviewHistory.Find(_history, id);
        if (item is null)
        {
            return;
        }

        ShowResult(item);
    }

    // 生成中の経過秒を 1 秒刻みで更新する (P2-2)。
    // System.Timers.Timer ではなく PeriodicTimer を使い、UI 更新は InvokeAsync(StateHasChanged) で
    // レンダラのコンテキストへ戻す。ループは ct のキャンセルでのみ終わる。
    private async Task TickElapsedAsync(DateTimeOffset startedAt, CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                // 加算ではなく開始時刻との差を取る (刻みがずれても表示が遅れない)。
                _elapsed = DateTimeOffset.UtcNow - startedAt;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // 生成完了 / エラー / ページ離脱によるキャンセル。正常系。
        }
        catch (ObjectDisposedException)
        {
            // 離脱直後にレンダラが落ちた場合。もう表示更新は要らないので黙って抜ける。
        }
    }

    public async ValueTask DisposeAsync()
    {
        // 生成中にページを離れてもタイマーを止める (経路 3)。
        // GenerateAsync 側は「参照を外す → Cancel → Dispose」の順なので、
        // ここから見える cts は必ず生存している。
        _tickCts?.Cancel();

        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
