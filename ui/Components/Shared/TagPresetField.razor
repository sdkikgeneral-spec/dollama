@* ラベル + 専用プリセット・カード一覧 + チップ入力 を 1 セットにした再利用フィールド。
   プロンプト用 (Kind="prompt") とネガティブ用 (Kind="negative") で 1 つずつ使う。
   プリセットは Kind で型分けされ、このフィールドのカード一覧からは同 Kind のものだけ見える。
   各カード = サムネ (直近生成画像) + 名前 + 削除 (×)。カード本体クリックでロード。 *@
@inject PresetStore Presets

<div class="field">
    <span>@Label</span>

    <!-- 専用プリセット・カード一覧 (この Kind 限定) -->
    @if (_presets.Count > 0)
    {
        <div class="preset-grid">
            @foreach (var p in _presets)
            {
                var url = Presets.ThumbnailUrl(p);
                <div class="preset-card" @onclick="() => Load(p)" title="@p.Name">
                    @if (url is not null)
                    {
                        <img src="@url" alt="@p.Name" />
                    }
                    else
                    {
                        <div class="preset-noimg">no image</div>
                    }
                    <div class="name">@p.Name</div>
                    <button type="button" class="del" title="削除"
                            @onclick="() => Delete(p)" @onclick:stopPropagation="true">×</button>
                </div>
            }
        </div>
    }

    <!-- 保存バー -->
    <div class="presetbar">
        <input class="preset-name" @bind="_newName" placeholder="保存名" />
        <button type="button" class="preset-btn" @onclick="SaveCurrent"
                disabled="@(string.IsNullOrWhiteSpace(_newName))">保存</button>
    </div>
    @if (_msg is not null)
    {
        <div class="preset-msg">@_msg</div>
    }

    <TagInput Tags="Tags" TagsChanged="OnTagsChanged" Placeholder="@Placeholder" />
</div>

@code {
    // 表示ラベル ("プロンプト" / "ネガティブ")
    [Parameter] public string Label { get; set; } = "";

    // プリセットの型 ("prompt" / "negative")
    [Parameter] public string Kind { get; set; } = "";

    // 親と共有するタグ列 (双方向バインド)
    [Parameter] public List<string> Tags { get; set; } = new();
    [Parameter] public EventCallback<List<string>> TagsChanged { get; set; }

    [Parameter] public string Placeholder { get; set; } = "タグを入力して Enter";

    // 直近生成画像の生バイト (PNG)。保存時にサムネとして使う。無ければサムネ無し保存。
    [Parameter] public byte[]? CurrentImage { get; set; }

    private IReadOnlyList<TagPreset> _presets = new List<TagPreset>();
    private string _newName = "";
    private string? _msg;

    protected override void OnInitialized()
    {
        // PresetStore はローカルファイル読みなのでプリレンダリング中でも安全 (同期・高速)
        _presets = Presets.All(Kind);
    }

    private async Task OnTagsChanged(List<string> tags)
    {
        Tags = tags;
        await TagsChanged.InvokeAsync(tags);
    }

    private async Task Load(TagPreset p)
    {
        // コピーで復元 (プリセット内のリストを直接編集しないため)
        await OnTagsChanged(new List<string>(p.Tags));
        _msg = $"「{p.Name}」をロードしました";
    }

    private void SaveCurrent()
    {
        var name = _newName.Trim();
        if (name.Length == 0)
        {
            return;
        }
        Presets.Save(new TagPreset
        {
            Name = name,
            Kind = Kind,
            Tags = new List<string>(Tags),
        }, CurrentImage);
        _presets = Presets.All(Kind);
        _newName = "";
        _msg = CurrentImage is not null
            ? $"「{name}」をサムネ付きで保存しました"
            : $"「{name}」を保存しました";
    }

    private void Delete(TagPreset p)
    {
        Presets.Delete(Kind, p.Name);
        _presets = Presets.All(Kind);
        _msg = $"「{p.Name}」を削除しました";
    }
}
